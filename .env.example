# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
NEXT_PUBLIC_JWT_SECRET=your-jwt-secret-key-change-in-production
NEXT_PUBLIC_TOKEN_EXPIRY=7d

# Blockchain Configuration
NEXT_PUBLIC_BLOCKCHAIN_NETWORK=testnet
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CHAIN_ID=80001

# Feature Flags
NEXT_PUBLIC_ENABLE_KYC=true
NEXT_PUBLIC_ENABLE_BLOCKCHAIN_VERIFICATION=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# External Services
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_INTERCOM_APP_ID=

# Exchange Rate API
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest
NEXT_PUBLIC_EXCHANGE_RATE_API_KEY=

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Rate Limiting
NEXT_PUBLIC_API_RATE_LIMIT=100
NEXT_PUBLIC_API_RATE_WINDOW=60000

# App Configuration
NEXT_PUBLIC_APP_NAME=RemitLink
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SUPPORT_EMAIL=support@remitlink.com
NEXT_PUBLIC_SUPPORT_PHONE=+1-800-REMIT-LINK

# Transaction Limits
NEXT_PUBLIC_MIN_TRANSFER_AMOUNT=10
NEXT_PUBLIC_MAX_TRANSFER_AMOUNT_UNVERIFIED=1000
NEXT_PUBLIC_MAX_TRANSFER_AMOUNT_VERIFIED=50000

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development
